diff --git a/bsd/sys/HoujiRootFs26.h b/bsd/sys/HoujiRootFs26.h
--- a/bsd/sys/HoujiRootFs26.h
+++ b/bsd/sys/HoujiRootFs26.h
@@ -1,10 +1,11 @@
 /* SPDX-License-Identifier: BSD-2-Clause-Patent */
 #ifndef HOUJI_ROOT_FS26_H
 #define HOUJI_ROOT_FS26_H
-/* The native device is a qualified HFSX volume. Mockfs accepts any device
- * and would expose that whole volume as its single executable, so it must not
- * win the RAM-root race: only sweet_hfs may claim the RAM disk. */
-static inline int hjrfs26_candidate(int native_root,const char *name) {
- return name && name[0]=='h' && name[1]=='f' && name[2]=='s' && name[3]==0;
+
+/* A raw PID1 image uses mockfs. A filesystem-backed root must pass HFS. */
+static inline int hjrfs26_candidate(int native_root, int ram_pid1, const char *name)
+{
+    const char *expected = native_root != 1 && ram_pid1 == 1 ? "mockfs" : "hfs";
+    return name && __builtin_strcmp(name, expected) == 0;
 }
 #endif
