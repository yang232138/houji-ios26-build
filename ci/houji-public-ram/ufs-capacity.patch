@@ -33,12 +40,84 @@ static uint32_t loadBe32 (const uint8_t *at)
   return (uint32_t (at[0]) << 24) | (uint32_t (at[1]) << 16) | (uint32_t (at[2]) << 8) | at[3];
 }
 
-// No physical command can be submitted, even if called by an in-kernel client.
-static IOReturn hostSubmit (__unused uint32_t direction, __unused uint32_t dataBytes,
-                            __unused uint32_t timeoutUs, uint32_t *ocs)
+// Submit only the single qualified LUN0 READ CAPACITY(16) command.
+static IOReturn hostSubmit (uint32_t direction, uint32_t dataBytes, uint32_t timeoutUs, uint32_t *ocs)
 {
   *ocs = 15;
-  return kIOReturnNotPermitted;
+  if (!gHost.virt || gHost.phaseACapacityIssued || !gHost.phaseAReadLease ||
+      !houjiUfsDataCommandAllowed(gHost.virt + kUcdOffset, 32, direction, dataBytes))
+    return kIOReturnNotPermitted;
+  if (!timeoutUs || dataBytes > kDataMax || (dataBytes & 3) ||
+      (dataBytes ? (direction != 1 && direction != 2) : direction != 0)) return kIOReturnBadArgument;
+  if (gHost.poisoned) return kIOReturnNotReady;
+  if (read32 (gHost.hc, 0x58) != 0) {
+    gHost.poisoned = true;
+    gHost.ready = false;
+    return recordTransport (kIOReturnBusy, *ocs);
+  }
+  if (read32 (gHost.hc, 0x20) & kUfsCapacityErrorStatus) {
+    gHost.poisoned = true;
+    gHost.ready = false;
+    return recordTransport (kIOReturnIOError, *ocs);
+  }
+  gRootDiagnostic.command++;
