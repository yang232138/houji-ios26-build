index 0000000..b78b3e5
--- /dev/null
+++ b/iokit/Kernel/houji-ufs-root/HoujiUfsCapacityPort.h
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef HOUJI_UFS_CAPACITY_PORT_H
+#define HOUJI_UFS_CAPACITY_PORT_H
+
+#include "HoujiUfsReadQualification.h"
+
+// State expected on the existing active legacy link after its former owner
+// explicitly stopped both queue engines and retired their request buffers.
+static inline bool houjiUfsIdleHandoff(const HoujiUfsQueueIo &io, uint64_t expectedBase) {
+    return houjiUfsQueueMatches(io, expectedBase, 0);
+}
+
+static inline bool houjiUfsOwnedRange(uint64_t base, uint64_t bytes,
+                                      uint64_t start, uint64_t length) {
+    return base && length && base <= UINT64_MAX - bytes && start <= UINT64_MAX - length &&
+        start >= base && start - base <= bytes &&
+        length <= bytes - (start - base);
+}
+
+#endif
