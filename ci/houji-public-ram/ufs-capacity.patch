index 0000000..36faf96
--- /dev/null
+++ b/iokit/Kernel/houji-ufs-root/HoujiUfsCapacityHandoff.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef HOUJI_UFS_CAPACITY_HANDOFF_H
+#define HOUJI_UFS_CAPACITY_HANDOFF_H
+
+#include "ArmSmmu4KContext.h"
+class IOBufferMemoryDescriptor;
+
+// Trusted board-internal handoff, after ExitBootServices. The producer keeps
+// the link active, relinquishes the legacy queues, publishes an already
+// isolated SID 0x60 translation, and transfers exclusive ownership of the
+// queue, context bank, ASID and immutable table memory. Boot args and ADT
+// addresses alone do not confer ownership.
+struct HoujiUfsCapacityHandoff {
+    IOBufferMemoryDescriptor *requests;
+    IOBufferMemoryDescriptor *pageTables;
+    const ArmSmmu4KContextConfig *context;
+    unsigned tablePages;
+    unsigned streamSlot;
+    unsigned contextBank;
+};
+
+extern "C" int houji26_ufs_capacity_from_handoff(const HoujiUfsCapacityHandoff *, uint64_t *blocks);
+#endif
diff --git a/iokit/Kernel/houji-ufs-root/HoujiUfsCapacityNative.inc b/iokit/Kernel/houji-ufs-root/HoujiUfsCapacityNative.inc
new file mode 100644
index 0000000..8d48da8
--- /dev/null
+++ b/iokit/Kernel/houji-ufs-root/HoujiUfsCapacityNative.inc
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Phase A sees only one CAPACITY(16) request and never alters SMMU routing.
+#include "HoujiUfsCapacityPort.h"
+
+static constexpr uint64_t kCapacitySmmuAddress = 0x15000000;
+static constexpr unsigned kCapacitySmmuBytes = 0x100000;
+static constexpr unsigned kCapacityMaxTablePages = 8;
+
+struct HoujiCapacityTables {
+  const volatile uint64_t *words;
+  uint64_t physical, bytes;
+};
+
+static int probeTableRead(void *cookie, uint64_t address, uint64_t *value) {
+  const auto &tables = *static_cast<const HoujiCapacityTables *>(cookie);
+  if ((address & 7) || !houjiUfsOwnedRange(tables.physical, tables.bytes, address, 8)) return 1;
+  *value = tables.words[(address - tables.physical) / 8];
+  return 0;
+}
+
+static int probeHciRead(void *, size_t offset, uint32_t *value) {
+  if (!gHost.hc || (offset & 3) || offset > UFS_HC_SIZE - 4) return 1;
+  *value = read32(gHost.hc, static_cast<unsigned>(offset));
+  return 0;
+}
+
+static int probeSmmuRead32(void *, size_t offset, uint32_t *value) {
+  if (!gHost.smmu || (offset & 3) || offset > kCapacitySmmuBytes - 4) return 1;
+  *value = read32(gHost.smmu, static_cast<unsigned>(offset));
+  return 0;
+}
+
+static int probeSmmuRead64(void *, size_t offset, uint64_t *value) {
+  if (!gHost.smmu || (offset & 7) || offset > kCapacitySmmuBytes - 8) return 1;
+  *value = *reinterpret_cast<volatile uint64_t *>(gHost.smmu + offset);
+  return 0;
+}
+
+// The shared observers require complete IO callbacks. No SMMU write is valid.
+static int probeDeny32(void *, size_t, uint32_t) { return 1; }
+static int probeDeny64(void *, size_t, uint64_t) { return 1; }
+static int probeBarrier(void *) {
+  probeDeviceBarrier();
+  return 0;
+}
+
+static uint64_t probeOwnedBuffer(IOBufferMemoryDescriptor &memory, uint64_t bytes) {
+  IOByteCount contiguous = 0;
+  const uint64_t physical = memory.getPhysicalSegment(0, &contiguous, kIOMemoryMapperNone);
+  const uintptr_t virt = reinterpret_cast<uintptr_t>(memory.getBytesNoCopy());
+  if (!virt || (virt & 4095) || !physical || (physical & 4095) ||
+      memory.getLength() < bytes || contiguous < bytes ||
+      !houjiUfsOwnedRange(gPhysBase, gPhysSize, physical, bytes))
+    return 0;
+  return physical;
+}
+
+static int probeStop(const char *why) {
+  IOLog("HOUJI26 UFS CAPACITY STOP: %s\n", why);
+  return kIOReturnNotReady;
+}
+
+static int runProbeCapacity(const HoujiUfsCapacityHandoff *handoff, uint64_t *blocks) {
+  static unsigned claimed;
+  if (!blocks) return kIOReturnBadArgument;
+  *blocks = 0;
+  if (!handoff || !handoff->requests || !handoff->pageTables || !handoff->context)
+    return probeStop("no trusted board handoff");
+  if (__atomic_exchange_n(&claimed, 1U, __ATOMIC_ACQ_REL))
+    return probeStop("one attempt per boot");
+  if (handoff->requests == handoff->pageTables || handoff->tablePages == 0 ||
+      handoff->tablePages > kCapacityMaxTablePages)
+    return probeStop("invalid DMA or page-table memory");
+  if (probeCacheLineBytes() != 64) return probeStop("cache line differs from the 64-byte transport");
+
+  const uint64_t bufferPa = probeOwnedBuffer(*handoff->requests, kDmaBytes);
+  const uint64_t tableBytes = uint64_t(handoff->tablePages) * 4096;
+  const uint64_t tablePa = probeOwnedBuffer(*handoff->pageTables, tableBytes);
+  const auto &context = *handoff->context;
+  if (!bufferPa || !tablePa || !context.lower || !context.lower_tables || context.upper ||
+      context.upper_tables || !context.coherent_walk || context.lower->table_physical != tablePa ||
+      context.lower_tables->table_pages > handoff->tablePages ||
+      (bufferPa < tablePa + tableBytes && tablePa < bufferPa + kDmaBytes))
+    return probeStop("DMA and table pools are not separate owned memory");
+
+  // The producer has relinquished these allocations. Keep both pinned on
+  // every path once adopted, especially if a timeout leaves DMA outstanding.
+  handoff->requests->retain();
+  handoff->pageTables->retain();
+  gHost.dma = handoff->requests;
+  gHost.virt = static_cast<uint8_t *>(handoff->requests->getBytesNoCopy());
+  gHost.phys = bufferPa;
+  gHost.lock = IOLockAlloc();
+  if (!gHost.lock) return probeStop("queue lock");
+  gHost.hc = mapPhys(UFS_HC_BASE, UFS_HC_SIZE, gHost.hcMap);
+  gHost.smmu = mapPhys(kCapacitySmmuAddress, kCapacitySmmuBytes, gHost.smmuMap);
+  if (!gHost.hc || !gHost.smmu) return probeStop("HCI or SMMU mapping");
+  const unsigned caps = read32(gHost.hc, 0);
+  if (!(caps & (1U << 24)) && bufferPa + kDmaBytes > UINT64_C(0x100000000))
+    return probeStop("controller DMA address width");
+  const HoujiUfsQueueIo queue = {nullptr, probeHciRead};
+  if (!houjiUfsIdleHandoff(queue, 0)) return probeStop("legacy queue not released and idle");
+
+  HoujiCapacityTables pool = {
+    static_cast<const volatile uint64_t *>(handoff->pageTables->getBytesNoCopy()), tablePa, tableBytes};
+  const ArmSmmu4KRange range = {bufferPa, bufferPa, kDmaBytes, ArmSmmu4KRead | ArmSmmu4KWrite, 1, 3};
+  unsigned char visited[kCapacityMaxTablePages];
+  const ArmSmmu4KAuditRegion region = {&range, 1, handoff->tablePages,
+    size_t(handoff->tablePages) * 512, visited, sizeof(visited)};
+  const ArmSmmu4KAuditConfig audit = {{&pool, probeTableRead}, &region, nullptr};
+  const ArmSmmu4KIo smmu = {nullptr, kCapacitySmmuBytes, probeSmmuRead32, probeSmmuRead64,
+    probeDeny32, probeDeny64, probeBarrier};
+  const ArmSmmu4KStream expected = {handoff->streamSlot, 0x60};
+  ArmSmmu4KStreamState stream = {};
+  ArmSmmu4KStreamResult route;
+  if (ArmSmmu4KAdoptStreams(&smmu, &stream, &expected, 1, handoff->contextBank, &context, &route))
+    return probeStop("exclusive translated SID unavailable");
+  ArmSmmu4KAuditResult observed;
+  if (ArmSmmu4KObserveAuditedContext(&smmu, stream.bank, &context, &audit, &observed) ||
+      !observed.complete || !houjiUfsIdleHandoff(queue, 0))
+    return probeStop("initial table audit or final idle check");
+  gHost.cb = gHost.smmu + observed.after.context_offset;
+
+  bzero(gHost.virt, kDmaBytes);
+  cacheCivac(gHost.virt, kDmaBytes);
+  hostWrite(0x50, uint32_t(bufferPa));
+  hostWrite(0x54, uint32_t(bufferPa >> 32));
+  if (!houjiUfsIdleHandoff(queue, bufferPa))
+    return probeStop("request list address or idle readback");
+  hostWrite(0x60, 1);
+  if (!hostWaitRegister(0x60, 1, 1))
+    return probeStop("request list start timeout; buffers retained");
+
+  const HoujiUfsReadLease lease = {&queue, &smmu, &stream, &context, &audit};
+  gHost.phaseAReadLease = &lease;
+  gHost.ready = true;
+  const IOReturn status = hostReadProbeCapacity(blocks);
+  gHost.phaseAReadLease = nullptr;
+  gHost.ready = false;
+  if (status == kIOReturnTimeout) {
+    *blocks = 0;
+    return probeStop("READ CAPACITY timeout; queue and DMA retained");
+  }
+  if (gHost.poisoned || !houjiUfsQueueMatches(queue, bufferPa) ||
+      ArmSmmu4KObserveStreams(&smmu, &stream, &context, &route)) {
+    *blocks = 0;
+    return probeStop("controller ownership uncertain; buffers retained");
+  }
+  hostWrite(0x60, 0);
+  if (!hostWaitRegister(0x60, 1, 0) || !houjiUfsIdleHandoff(queue, bufferPa)) {
+    *blocks = 0;
+    return probeStop("request list stop not confirmed; buffers retained");
+  }
+  hostWrite(0x50, 0);
+  hostWrite(0x54, 0);
+  if (!houjiUfsIdleHandoff(queue, 0)) {
+    *blocks = 0;
+    return probeStop("queue clear readback; buffers retained");
+  }
+  if (status != kIOReturnSuccess) {
+    IOLog("HOUJI26 UFS CAPACITY STOP: REPLY IOReturn=%x SCSI=%x OCS=%x\n",
+          unsigned(status), gRootDiagnostic.scsi, gRootDiagnostic.ocs);
+    return status;
+  }
+  IOLog("HOUJI26 UFS CAPACITY PASS: LUN0 blocks=%llu block_size=4096\n",
+        static_cast<unsigned long long>(*blocks));
+  return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/houji-ufs-root/HoujiUfsCapacityPort.h b/iokit/Kernel/houji-ufs-root/HoujiUfsCapacityPort.h
